            </value>
          </match>
        </li>

        <!-- ================================ Violon =============================== -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Prop_Violin"]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="Prop_Violin"]/rotatable</xpath>
                <!-- Conditionnel et non Replace sec : si l'auteur amont retire un jour la ligne
