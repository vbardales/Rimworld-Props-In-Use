              </building>
              <comps>
                <li>
                  <compClass>CompQuality</compClass>
                </li>
                <li Class="MusicalInstruments.CompProperties_MusicSpot">
                  <compClass>MusicalInstruments.CompMusicSpot</compClass>
                  <canBeDisabled>false</canBeDisabled>
                </li>
                <li Class="MusicalInstruments.CompProperties_MusicalInstrument">
                  <compClass>MusicalInstruments.CompMusicalInstrument</compClass>
                  <easiness>0.2</easiness>
                  <expressiveness>0.8</expressiveness>
                  <isBuilding>true</isBuilding>
                </li>
                <!-- Mlie n'a qu'un seul son de vent, l'ocarina. Les trois vents de ce fichier le
                     partagent donc, faute de mieux : une ligne a changer le jour ou de vrais
                     echantillons existeront. -->
                <li Class="MusicalInstruments.CompProp_PlayingMusic">
                  <soundPlayInstrument>MIC_Ocarina_Play</soundPlayInstrument>
                </li>
              </comps>
            </value>
          </match>
        </li>

        <!-- ============================= Caisse claire =========================== -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Prop_Snare_Drum"]</xpath>
          <match Class="PatchOperationSequence">
            <operations>
              <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName="Prop_Snare_Drum"]/rotatable</xpath>
                <!-- Conditionnel et non Replace sec : si l'auteur amont retire un jour la ligne
                     `rotatable false`, un Replace echouerait bruyamment alors qu'il n'y aurait
                     plus rien a corriger - la valeur par defaut de `rotatable` etant deja vraie. -->
                <match Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="Prop_Snare_Drum"]/rotatable</xpath>
                  <value>
                    <rotatable>true</rotatable>
                  </value>
                </match>
                </li>
              <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Prop_Snare_Drum"]</xpath>
                <value>
                  <tickerType>Normal</tickerType>
                  <hasInteractionCell>True</hasInteractionCell>
                  <interactionCellOffset>(0,0,-1)</interactionCellOffset>
                  <socialPropernessMatters>true</socialPropernessMatters>
                  <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
                  <building>
                    <joyKind>Music</joyKind>
                  </building>
                  <comps>
                    <li>
                      <compClass>CompQuality</compClass>
                    </li>
                    <li Class="MusicalInstruments.CompProperties_MusicSpot">
                      <compClass>MusicalInstruments.CompMusicSpot</compClass>
                      <canBeDisabled>false</canBeDisabled>
                    </li>
                    <!-- Facile a jouer, peu expressif : c'est tout l'interet d'un tambour pour un
                         colon sans oreille. -->
                    <li Class="MusicalInstruments.CompProperties_MusicalInstrument">
                      <compClass>MusicalInstruments.CompMusicalInstrument</compClass>
                      <easiness>0.6</easiness>
                      <expressiveness>0.4</expressiveness>
                      <isBuilding>true</isBuilding>
                    </li>
                    <li Class="MusicalInstruments.CompProp_PlayingMusic">
                      <soundPlayInstrument>MIC_FrameDrum_Play</soundPlayInstrument>
                    </li>
                  </comps>
                </value>
              </li>
            </operations>
          </match>
        </li>

        <!-- =============================== Trombone ============================== -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="Prop_Trombone"]</xpath>
          <match Class="PatchOperationAdd">
